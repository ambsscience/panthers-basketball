rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only these coach accounts can read or write team data.
    // Type every email exactly as you created it in Authentication > Users, in lowercase.
    function isCoach() {
      return request.auth != null
        && request.auth.token.email in [
          'head.coach@example.com',
          'assistant.coach@example.com'
        ];
    }
    match /teams/{team}/{document=**} {
      allow read, write: if isCoach();
    }
  }
}
